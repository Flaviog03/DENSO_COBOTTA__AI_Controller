# ==========================================
# FILE DI CONFIGURAZIONE (Template)
# Rinomina questo file in ".env" prima di avviare l'eseguibile.
# ==========================================

# 1. Indirizzo IP del controller DENSO (es: 192.168.0.1, oppure l'IP del simulatore WINCAPS)
CONTROLLER_ADDRESS=192.168.0.1

# 2. Parametri AI Locale (LM Studio)
# URL del server locale
LLM_URL=http://localhost:1234/v1/chat/completions

# Nome del modello attualmente caricato nel server (lo sviluppatore ha usato nemotron-3-nano-4b)
LLM_MODEL=nemotron-3-nano-4b
